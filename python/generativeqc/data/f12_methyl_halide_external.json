    "sylvetsky-2017": {
      "url": "https://doi.org/10.1063/1.4998332",
      "procedure": "write the carbon diffuse exponents of the aug-cc-pVnZ-F12 row of Table I as an NWChem block: a BASIS \"ao basis\" SPHERICAL PRINT line, one uncontracted shell per exponent with coefficient 1.0 in increasing angular momentum, then END",
      "version": "published article"
    },
