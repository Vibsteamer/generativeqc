{
  "schema": "generativeqc.f12-methyl-halide-external/v1",
  "description": "SHA-256 records of the CH3Br/CH3I scalar-ECP F12 basis selections and geometries. No coefficients or coordinates are distributed; see docs/user/restricted_reference_data.md.",
  "series_id": "methyl-halide-ha-PP-F12/def2-universal-JKFit/element-RI",
  "beta_bohr_inverse_by_cardinal": {
    "2": 0.9,
    "3": 1.0
  },
  "beta_policy": "Locked Plan-A size-consistent F12 geminal exponents {2: 0.9, 3: 1.0} bohr^-1 matching DEFAULT_PRODUCTION_F12_BETA_BY_CARDINAL",
  "data_directory": {
    "argument": "data_dir",
    "environment": "GENERATIVEQC_EXTERNAL_DATA_DIR",
    "subdirectory": "f12_methyl_halide"
  },
  "content_hashes": {
    "basis": "generativeqc.basis.element_content_sha256 (generativeqc.basis-element-content/v1, spherical)",
    "geometry": "generativeqc.experimental.f12_methyl_halide.geometry_content_sha256 (generativeqc.geometry-content/v1)",
    "assembly": "records are concatenated in order; layout native keeps source order, bse-standard applies BSE uncontract_general, uncontract_spdf and sort_basis, sorted-by-l stable-sorts shells by angular momentum; groups zero, position or source set shell source groups; ecp text bse is BSE ecp_potentials as compact sorted-key JSON, float-repr is json.dumps default formatting of the keys ecp_type, angular_momentum, r_exponents, gaussian_exponents and coefficients with repr(float(value)) strings"
  },
  "bse": {
    "package": "basis_set_exchange",
    "verified_versions": [
      "0.12"
    ],
    "license": "BSD-3-Clause",
    "citation": "B. P. Pritchard, D. Altarawy, B. Didier, T. D. Gibson and T. L. Windus, J. Chem. Inf. Model. 59, 4814 (2019), doi:10.1021/acs.jcim.9b00725"
  },
  "sources": {
    "ccrepo-bromine": {
      "url": "http://www.grant-hill.group.shef.ac.uk/ccrepo/bromine/brbasis.php",
      "request": "HTTP POST form",
      "procedure": "submit the fields basis=<query basis> and program=NWChem; take the text of the first <nobr> element of the response, collapse whitespace runs in each line to one space, strip each line, drop empty lines and join the lines with newlines plus a final newline. Only the content hash is enforced; the file hash identifies the bytes this procedure produced",
      "version": "ccRepo publishes no version identifier; records are identified by content hash"
    },
    "ccrepo-iodine": {
      "url": "http://www.grant-hill.group.shef.ac.uk/ccrepo/iodine/ibasis.php",
